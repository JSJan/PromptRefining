# Required: At least one LLM provider API key
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# GitHub token (fallback for OpenAI models via GitHub Models)
# Get one at: https://github.com/settings/tokens
# Requires access to GitHub Models (models.inference.ai.github.com)
GITHUB_TOKEN=

# Optional: Server configuration
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Optional: Default model for refinement
DEFAULT_REFINEMENT_PROVIDER=openai
DEFAULT_REFINEMENT_MODEL=gpt-4o
